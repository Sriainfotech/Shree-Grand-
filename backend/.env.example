PORT=5000
NODE_ENV=development

# Neon (serverless Postgres) connection strings. NOT a local Postgres
# instance — create a free project at https://neon.tech, then copy both
# connection strings from the Neon dashboard's "Connect" panel:
#
# DATABASE_URL  — the POOLED connection (has "-pooler" in the host), used by
#                 the running app.
# DIRECT_URL    — the DIRECT/unpooled connection (no "-pooler"), used only
#                 for `prisma migrate`.
#
# Both need sslmode=require (Neon requires TLS).
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/shree-grand-farmstay?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/shree-grand-farmstay?sslmode=require
DATABASE_URL=
DIRECT_URL=

# Long random string — e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:3000

# Business WhatsApp number in international format, no "+" or spaces
# (used to build wa.me chat links via /api/whatsapp/link).
BUSINESS_WHATSAPP_NUMBER=

# Optional — only needed for server-side admin notifications on new
# bookings/inquiries via Meta's WhatsApp Cloud API. Leave blank to skip
# notifications entirely; nothing else in the app depends on these.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=

# Email — the "contact form sends an email" requirement. Works with any SMTP
# provider (Gmail with an app password, SendGrid, Mailgun, Resend's SMTP
# relay, your host's mailbox, etc). Every new booking/inquiry emails
# CONTACT_RECEIVER_EMAIL with the full form details, and (if the visitor
# gave an email) sends them a short confirmation too. Leave blank to skip
# email entirely — nothing else in the app depends on these.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=

# Optional — only needed to enable the payment endpoints (POST
# /api/payments/orders, /api/payments/verify). Until both are set, those
# routes return 503 rather than accepting a fake/placeholder payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
