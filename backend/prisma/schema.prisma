// Prisma schema — Neon (serverless Postgres).
//
// Status/role fields are kept as plain lowercase `String`s with app-level
// validation (see src/validators/*.js) rather than native Postgres enums —
// this mirrors the string-enum style the previous Mongoose schemas used, so
// every existing value ("pending", "published", "admin", ...) stays valid
// with no casing/mapping translation layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) — used by the running app.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only for migrations. Neon gives you
  // both; see .env.example.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("editor") // "admin" | "editor"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Singleton — a booking is always for the whole property (never a
// particular part of it), so there is exactly one row here, fixed at
// id "property". Managed via the admin "Property" settings page.
model Property {
  id            String   @id @default("property")
  name          String   @default("Shri Grand Farm Stay")
  description   String   @default("")
  images        String[] @default([])
  amenities     String[] @default([])
  guestCapacity Int?
  pricePerDay   Float?
  priceLabel    String   @default("Price on request")
  updatedAt     DateTime @updatedAt

  @@map("property")
}

model Booking {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?

  checkIn  DateTime
  checkOut DateTime?
  guests   Int

  occasion String?
  message  String @default("")
  slot     String @default("full_day") // full_day | half_day_morning | half_day_evening — forced to full_day whenever checkOut is set

  status String @default("pending") // pending | confirmed | cancelled | completed

  // Price snapshots taken at creation time from Property.pricePerDay, so a
  // later price change never retroactively changes an existing booking.
  totalAmount   Float?
  advanceAmount Float?
  paymentType   String? // advance | full — chosen by the guest at checkout
  // unpaid | pending_verification | advance_paid | paid | refunded
  // Razorpay's signature check moves unpaid -> pending_verification (the
  // gateway confirmed the charge, but a human hasn't double-checked it yet);
  // an admin's explicit verification moves pending_verification -> paid/advance_paid.
  paymentStatus String  @default("unpaid")
  paymentVerifiedAt DateTime? // when an admin verified the payment (set alongside paid/advance_paid)
  paymentVerifiedBy String? // "admin_panel" | "email_link" — how it was verified, for the audit trail
  source        String  @default("website") // website | whatsapp | phone | walk_in

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, checkIn])
  @@map("bookings")
}

model Inquiry {
  id       String  @id @default(cuid())
  name     String
  phone    String
  email    String?
  occasion String?
  message  String  @default("")

  status String @default("new") // new | contacted | closed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("inquiries")
}

model Testimonial {
  id     String   @id @default(cuid())
  name   String
  role   String?
  review String
  rating Int?
  image  String?
  date   DateTime @default(now())

  // Never public until an admin explicitly approves it.
  published Boolean @default(false)
  featured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, featured])
  @@map("testimonials")
}

model BlogPost {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  excerpt  String  @default("")
  content  String  @default("")
  category String?
  image    String?
  author   String  @default("Shri Grand Farm Stay")

  status      String    @default("draft") // draft | published
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model GalleryImage {
  id        String  @id @default(cuid())
  title     String  @default("")
  category  String // pool | rooms | lawn | party-hall | garden | dining | campfire | events | drone
  type      String  @default("image") // image | video
  url       String
  caption   String  @default("")
  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published, order])
  @@map("gallery_images")
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount   Int // smallest currency unit (paise)
  currency String @default("INR")

  gateway          String  @default("razorpay")
  gatewayOrderId   String
  gatewayPaymentId String?
  gatewaySignature String?

  status String @default("created") // created | paid | failed | refunded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@map("payments")
}
